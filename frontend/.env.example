# ---- MRNet frontend API configuration ----
# The frontend always talks to the real backend (backend/server.py). Copy this
# file to frontend/.env only to override the defaults; restart `npx vite` after
# editing (Vite bakes these in at dev-server start).

# Backend target. '/api' is proxied by Vite to http://localhost:8000
# where `python backend/server.py` (repo root) serves the outputs/ models.
# For a hosted backend put its full URL here, e.g. https://your-service.example.com
VITE_API_BASE=/api

# Auth (optional, only needed when the backend was started with MRNET_API_KEY).
# Sent as `Authorization: Bearer <key>` by default; set VITE_API_KEY_HEADER
# (e.g. X-API-Key) to use a plain custom header instead.
VITE_API_KEY=
VITE_API_KEY_HEADER=Authorization
