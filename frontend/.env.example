# ---- MRNet frontend API configuration ----
# Copy this file to frontend/.env and fill in real values when you have keys.
# Restart `npx vite` after changing .env (Vite bakes these in at dev-server start).

# mock = built-in simulated backend (default; no server, no keys needed)
# live = real HTTP backend
VITE_API_MODE=mock

# Live mode target. '/api' is proxied by Vite to http://localhost:8000
# where `python backend/server.py` (repo root) serves the outputs/ models.
# For a hosted service put its full URL here instead.
VITE_API_BASE=/api

# Auth for live mode (optional). Sent as `Authorization: Bearer <key>` by default.
# To use a plain custom header instead (e.g. X-API-Key), set VITE_API_KEY_HEADER.
VITE_API_KEY=
VITE_API_KEY_HEADER=Authorization
